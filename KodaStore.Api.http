@baseUrl = http://localhost:5231

GET {{baseUrl}}/weatherforecast/
Accept: application/json

### Get Product All
GET {{baseUrl}}/api/v1/products
Accept: application/json

### Get Product By Code
GET {{baseUrl}}/api/v1/products/PR001
Accept: application/json

### POST Product
POST {{baseUrl}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "productCode": "P005",
    "name": "",
    "price": -3000,
    "stock": 12,
    "category": "Elektronik"
}

### UPDATE DATA
PUT {{baseUrl}}/api/v1/products/P002
Accept: application/json
Content-Type: application/json

{
    "name": "Remote",
    "price": 35000,
    "stock": 20,
    "category": "TV"
}

### Delete Product
DELETE {{baseUrl}}/api/v1/products/PR001
Accept: application/json

### Upload Gambar
POST {{baseUrl}}/api/v1/products/P002/image
Content-Type: multipart/form-data; boundary=KodaStore

--KodaStore
Content-Disposition: form-data; name="file"; filename="valid_product.jpg"
Content-Type: image/jpeg

< C:\Upload\valid_product.jpg
--KodaStore--
